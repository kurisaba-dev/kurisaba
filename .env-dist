#########
# Ports #
#########

# Port on which imageboard will be available on host system
FRONTEND_PORT=81

# Port on which phpMyAdmin will be available on host system, if started
PMA_PORT=8081


###################
# Database config #
###################

# Database to create for imageboard
MARIADB_DATABASE=kurisaba

# User/password to be used by imageboard for accessing the database
MARIADB_USER=kurisaba
MARIADB_PASSWORD=!!PUT_SOMETHING_SECRET_HERE!!

# Root password for MariaDB and phpMyAdmin
MARIADB_ROOT_PASSWORD=!!PUT_SOMETHING_EVEN_MORE_SECRET_HERE!!
