$cf['KU_DSN']        = 'mysql:host=localhost;dbname=kurisaba'; // DSN-строка, описывающая способ соединения с базой данных для PDO. Более подробно: https://www.php.net/manual/en/pdo.connect.php
$cf['KU_DBUSERNAME'] = 'db_user';   // Имя пользователя. На SQLite игнорируется.
